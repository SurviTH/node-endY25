<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

    <body>
        <%- include('partials/nav', { title: title }) %>
            <div class="blogs content">
                <h2>All Blogs</h2>
                <% if (blogs && blogs.length> 0) { %>
                    <% blogs.forEach(blog=> { %>
                        <div class="blog">
                            <h3>
                                <%= blog.title %>
                            </h3>
                            <p>
                                <%= blog.snippet %>
                            </p>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <p>No blogs available.</p>
                                <% } %>
            </div>
            <%- include('partials/footer') %>

    </body>

</html>